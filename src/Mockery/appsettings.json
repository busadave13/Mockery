{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MockRepository": {
    "Type": "Local",
    "LocalPath": "../..",
    "Git": {
      "RepositoryUrl": "",
      "Branch": "main",
      "ClonePath": "/app/mocks",
      "AccessToken": ""
    }
  },
  "Throttling": {
    "Enabled": true,
    "RequestsPerSecond": 200,
    "BurstSize": 50,
    "ExcludedPaths": [
      "/health/live",
      "/health/ready",
      "/health/startup",
      "/metrics"
    ]
  }
}
